# Tools binaries moved to parent folder (../.tools/) - shared across workspaces
# Kept as safety net in case .tools/ is accidentally created in workspace
.tools/

# Private sessions folder (entire folder excluded from git)
_PrivateSessions/

# Temporary files
.tmp_*
*.tmp

# Workflow scaffolding (auto-created process artifacts, not deliverables)
__*.md

# Suffix-based gitignore (append _gitignore before extension to exclude any file/folder)
*_gitignore.*
*_gitignore/

# IDE (keep .vscode/ - shared config)
.vs/

# Python
__pycache__/
*.pyc

# API keys
.api-keys.txt
